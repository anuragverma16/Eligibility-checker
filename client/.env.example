# Copy to client/.env for local overrides, or set these in Vercel's Environment Variables.
# Vite inlines VITE_* values at build time, so changing one requires a new build/deploy.

# Leave empty for local development (the Vite dev server proxies /api to http://localhost:5001).
# Production (Vercel): set to your Render API URL, with no trailing slash.
VITE_API_BASE_URL=
